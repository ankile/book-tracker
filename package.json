{
  "name": "book-tracker",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run check && npm run test:pwa && npm run test:functions",
    "test:bundle": "node --test tests/bundle-budget.test.mjs",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "test:functions": "npm --prefix functions test",
    "validate": "npm test && npm run build && npm run test:bundle && npm audit --omit=dev && npm --prefix functions audit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@typescript-eslint/types": "^8.64.0",
    "sass": "^1.101.0",
    "svelte": "^5.56.6",
    "svelte-awesome": "^3.3.5",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "firebase": "^12.16.0"
  }
}
