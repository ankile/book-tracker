---
title: Backend request and event paths
---
flowchart TB
  accTitle: Book Tracker backend request and event paths
  accDescr: Seven independent rows show public profile delivery, Google Books lookup, telemetry and administration, online Toggl calls, offline Toggl queue synchronization, authentication lifecycle cleanup, and book session cleanup. Every deployed function appears by its deployed name.

  classDef source fill:#f7f8f8,stroke:#8b9691,color:#263331,stroke-width:2px;
  classDef mediation fill:#fff7e8,stroke:#b98a3c,color:#5b421f,stroke-width:2px;
  classDef function fill:#edf4f6,stroke:#497789,color:#173d4a,stroke-width:2px;
  classDef data fill:#eaf7ef,stroke:#2e7d55,color:#17482f,stroke-width:2px;
  classDef external fill:#f7f3ed,stroke:#9b7b52,color:#4c3926,stroke-width:2px;
  classDef security fill:#fff1f0,stroke:#b42318,color:#651c15,stroke-width:2px;
  classDef note fill:#ffffff,stroke:#8b9691,color:#40504d,stroke-width:1px,stroke-dasharray:4 3;

  subgraph publicpath[Public profiles and search]
    direction LR
    webrequest["<b>Visitor or crawler</b><br/><code>/profiles/**</code><br/><code>/sitemap.xml</code>"]:::source
    webhosting["<b>Hosting rewrite</b><br/>Pinned Cloud Run revision"]:::mediation
    publicweb["<b>publicweb · Gen 2</b><br/>Public HTTP · max 2 instances<br/><code>publicweb-runtime</code>"]:::function
    profiledata[("<b>Profile documents</b><br/><code>profiles/{username}</code><br/><code>profileDiscovery/{username}</code>")]:::data
    webresponse["<b>Response</b><br/>Public: HTML, JSON, or sitemap<br/>Private/missing: indistinguishable 404"]:::source
    webrequest --> webhosting --> publicweb
    publicweb -->|"Admin SDK · read-only IAM"| profiledata
    profiledata --> webresponse
  end

  subgraph metadatapath[Metered ISBN metadata]
    direction LR
    bookdialog["<b>Add or edit book</b><br/>Firebase ID token"]:::source
    booksapi["<b>booksapi-lookupisbn · Gen 1</b><br/>Handler requires signed-in user<br/>60 lookups per user per hour"]:::function
    booksquota[("<b>Quota</b><br/><code>users/{uid}/functionQuotas</code>")]:::data
    secret["<b>Secret Manager</b><br/><code>FUNCTIONS_CONFIG_EXPORT</code>"]:::security
    google["<b>Google Books API</b><br/>ISBN metadata"]:::external
    bookdialog --> booksapi --> google
    booksapi -->|"consume quota"| booksquota
    secret -. "API key" .-> booksapi
  end

  subgraph operationspath[Client issue reports and operator overview]
    direction LR
    clientissue["<b>Signed-in browser</b><br/>Allowlisted warn/error event"]:::source
    telemetry["<b>telemetry-reportissue · Gen 1</b><br/>20 reports per user per hour"]:::function
    opsdata[("<b>Operations data</b><br/><code>logEvents</code> · issue quota<br/>server-owned TTL fields")]:::data
    adminrequest["<b>Fixed verified operator</b>"]:::source
    admin["<b>admin-overview · Gen 1</b><br/>UID + verified-email gate<br/>max 2 instances"]:::function
    adminsources[("<b>Admin sources</b><br/>Auth users · private libraries<br/><code>logEvents</code>")]:::data
    audit[("<b>Audit output</b><br/><code>adminAudit</code> · TTL")]:::data
    clientissue --> telemetry --> opsdata
    adminrequest --> admin --> adminsources
    admin -->|"successful view"| audit
  end

  subgraph togglonline[Online Toggl configuration and timers]
    direction LR
    onlinebrowser["<b>Signed-in browser</b><br/>Profile settings or book timer"]:::source
    tokenfn["<b>Token callables · Gen 1</b><br/>toggl-savetoken<br/>toggl-cleartoken"]:::function
    timerfn["<b>Timer callables · Gen 1</b><br/>toggl-start · toggl-stop<br/>toggl-clearstopping"]:::function
    timerstate[("<b>Owner timer state</b><br/><code>users/{uid}</code> config<br/>book + <code>timerLifecycle/current</code>")]:::data
    togglapi["<b>Toggl Track API v9</b><br/>Token validation and timers"]:::external
    onlinebrowser --> tokenfn --> timerstate
    onlinebrowser --> timerfn --> timerstate
    tokenfn --> togglapi
    timerfn --> togglapi
  end

  subgraph toggloffline[Offline Toggl recovery]
    direction LR
    offlinebrowser["<b>Browser goes offline</b><br/>Stop or finished timer"]:::source
    localqueue["<b>Firestore IndexedDB</b><br/>Queued atomic client batch"]:::mediation
    queuedoc[("<b>Firestore queue row</b><br/><code>users/{uid}/togglQueue/{queueId}</code><br/>Rules validate payload and timer claim")]:::data
    queueevent["<b>Eventarc delivery</b><br/>Gen 2 · internal-only ingress"]:::mediation
    syncqueue["<b>toggl-syncqueue · Gen 2</b><br/>Claim, quota, retry<br/>create or patch entry"]:::function
    queuedtoggl["<b>Toggl Track API v9</b><br/>Create or patch time entry"]:::external
    queueresult[("<b>Queue result</b><br/>Success deletes row<br/>terminal failure gets 90-day TTL")]:::data
    offlinebrowser --> localqueue -->|"flushes after reconnect"| queuedoc
    queuedoc --> queueevent --> syncqueue --> queuedtoggl
    syncqueue --> queueresult
  end

  subgraph authpath[Authentication lifecycle]
    direction LR
    authevent["<b>Firebase Auth</b><br/>Account created or deleted"]:::source
    createuser["<b>createUserDocument · Gen 1</b><br/>Auth onCreate · retry enabled"]:::function
    deleteuser["<b>deleteUserDocument · Gen 1</b><br/>Auth onDelete · retry enabled"]:::function
    userroot[("<b>Account root</b><br/><code>users/{uid}</code><br/>idle timer lifecycle on create")]:::data
    deletedprofiles[("<b>Profiles and discovery markers</b><br/>Deleted page by page"]:::data
    remains["<b>Manual cleanup still required</b><br/>Books · updates · authors · timer lifecycle<br/>and Toggl queue subcollections remain"]:::security
    authevent -->|"create"| createuser --> userroot
    authevent -->|"delete"| deleteuser
    deleteuser -->|"delete root document only"| userroot
    deleteuser -->|"delete"| deletedprofiles
    deleteuser -. "Firestore does not cascade" .-> remains
  end

  subgraph bookcleanup[Book deletion cleanup]
    direction LR
    deletebook["<b>Owner deletes a book</b><br/>Validated client write"]:::source
    bookdoc[("<b>Deleted document</b><br/><code>users/{uid}/books/{bookId}</code>")]:::data
    bookevent["<b>Eventarc delivery</b><br/>Gen 2 · internal-only ingress"]:::mediation
    cascade["<b>deletebookupdates · Gen 2</b><br/>Retry enabled · max 5 instances"]:::function
    updates[("<b>Recursive cleanup</b><br/><code>books/{bookId}/updates/**</code>")]:::data
    deletebook --> bookdoc --> bookevent --> cascade --> updates
  end

  observability["<b>Shared runtime behavior</b><br/>All functions write errors and warnings to Cloud Logging.<br/>Uptime checks and alert policies watch public HTTP, function errors, and Eventarc delivery."]:::note
