---
title: Book Tracker system context
---
flowchart LR
  accTitle: Book Tracker system context
  accDescr: Readers track personal books, connect them to a shared work catalog, and may opt into reader comparisons. The operator curates shared works and editions. Book Tracker also reads external metadata, serves public profiles, and optionally synchronizes timers with Toggl Track.

  classDef person fill:#f7f8f8,stroke:#8b9691,color:#263331,stroke-width:2px;
  classDef system fill:#e8f2f1,stroke:#35686a,color:#173f41,stroke-width:3px;
  classDef external fill:#f7f3ed,stroke:#9b7b52,color:#4c3926,stroke-width:2px;
  classDef legend fill:#ffffff,stroke:#c9d1cf,color:#40504d,stroke-width:1px,stroke-dasharray:4 3;

  subgraph people[People]
    direction TB
    reader["<b>Reader</b><br/>Tracks books, links shared works,<br/>and optionally shares reading summaries"]:::person
    visitor["<b>Profile visitor</b><br/>Reads a shared public profile"]:::person
    operator["<b>Operator</b><br/>Reviews operations and curates<br/>shared works and editions"]:::person
    crawler["<b>Search crawler</b><br/>Indexes opted-in public profiles"]:::person
  end

  app["<b>Book Tracker</b><br/>Private, offline-capable reading tracker<br/>with shared works, opt-in comparisons,<br/>public profiles, and optional Toggl sync"]:::system

  subgraph providers[External systems]
    direction TB
    catalogs["<b>Book metadata providers</b><br/>Open Library · Google Books<br/>Nasjonalbiblioteket"]:::external
    toggl["<b>Toggl Track</b><br/>Reading project and time entries"]:::external
  end

  reader -->|"uses"| app
  visitor -->|"opens shared profile"| app
  operator -->|"opens restricted overview and catalog"| app
  crawler -->|"reads sitemap and profile HTML"| app
  app -->|"looks up ISBN metadata"| catalogs
  app -->|"creates and stops timers"| toggl

  legend["<b>Legend</b><br/>Teal = Book Tracker · Gray = people · Sand = external system"]:::legend
