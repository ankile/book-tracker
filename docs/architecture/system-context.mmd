flowchart LR
  accTitle: Book Tracker system context
  accDescr: Readers use Book Tracker to manage a private reading library. People may also view shared profiles. The app obtains book information from external catalog services and can connect to an optional time-tracking service.

  classDef person fill:#f7f8f8,stroke:#8b9691,color:#263331,stroke-width:2px;
  classDef system fill:#e8f2f1,stroke:#35686a,color:#173f41,stroke-width:3px;
  classDef external fill:#f7f3ed,stroke:#9b7b52,color:#4c3926,stroke-width:2px;

  subgraph people[People · gray]
    direction TB
    reader["<b>Reader</b><br/>Tracks books, progress, sessions,<br/>authors, and reading statistics"]:::person
    visitor["<b>Profile visitor</b><br/>Reads a shared public profile"]:::person
    operator["<b>Authorized operator</b><br/>Reviews operational summaries"]:::person
    crawler["<b>Search indexer</b><br/>Finds profiles shared for discovery"]:::person
  end

  app["<b>Book Tracker</b><br/>Private, offline-capable reading tracker<br/>with optional sharing and integrations"]:::system

  subgraph providers[External services · sand]
    direction TB
    catalogs["<b>Book information services</b><br/>Metadata and cover information"]:::external
    timer["<b>Optional time-tracking service</b><br/>Reading activity synchronization"]:::external
  end

  reader -->|"uses"| app
  visitor -->|"opens shared profile"| app
  operator -->|"opens restricted view"| app
  crawler -->|"reads discoverable pages"| app
  app -->|"looks up book information"| catalogs
  app -->|"synchronizes reading activity"| timer
