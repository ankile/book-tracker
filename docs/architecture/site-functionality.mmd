title: Pages and navigation
---
flowchart LR
  accTitle: Book Tracker pages and navigation
  accDescr: Signed-in readers use the primary navigation for Currently Reading, Finished, and My site. My site links to Authors, Book metadata, and the reading profile. Shared links and search results can enter the public profile directly. Authorized operators can open the restricted overview. The separate route access matrix lists readers and writes for every page.

  classDef person fill:#f7f8f8,stroke:#8b9691,color:#263331,stroke-width:2px;
  classDef gate fill:#fff7e8,stroke:#b98a3c,color:#5b421f,stroke-width:2px;
  classDef page fill:#e8f2f1,stroke:#35686a,color:#173f41,stroke-width:2px;
  classDef public fill:#edf4f6,stroke:#497789,color:#173d4a,stroke-width:2px;
  classDef admin fill:#fff7f6,stroke:#b42318,color:#651c15,stroke-width:2px;

  subgraph entry[How people enter]
    direction TB
    signedout["<b>Signed-out visitor</b><br/>Private URL or app home"]:::person
    owner["<b>Signed-in reader</b><br/>Restored browser session"]:::person
    publicentry["<b>Public visitor</b><br/>Shared link · search result<br/>or direct profile URL"]:::person
    operator["<b>Authorized operator</b><br/>Restricted entry"]:::person
  end

  subgraph routes[Routes · teal private · blue profile · red admin]
    direction TB
    auth["<b>Login or register</b><br/>Rendered at <code>/</code> or the requested<br/>private route, then resumes it"]:::gate
    shell["<b>Signed-in shell</b><br/>Primary navbar"]:::gate

    current["<b>Currently Reading</b><br/><code>/</code><br/>Books in progress · pages · timers"]:::page
    finished["<b>Finished</b><br/><code>/finished</code><br/>Search · sort · year filter · totals"]:::page
    me["<b>My site</b><br/><code>/me</code><br/>Analytics · profile · optional integrations"]:::page

    authors["<b>Authors</b><br/><code>/authors</code><br/>Rename · classify · merge · delete"]:::page
    isbns["<b>Book metadata</b><br/><code>/isbns</code><br/>Find missing or unresolved ISBN data"]:::page
    profile["<b>Reading profile</b><br/><code>/profiles/[username]</code><br/>Stats · heatmap · records · links"]:::public
    admin["<b>Restricted overview</b><br/><code>/admin</code><br/>Operational summary"]:::admin
  end

  signedout --> auth --> shell
  owner --> shell
  publicentry --> profile
  operator --> admin

  shell -->|"Currently Reading"| current
  shell -->|"Finished"| finished
  shell -->|"My site"| me
  me -->|"Authors card"| authors
  me -->|"Needs an ISBN card"| isbns
  me -->|"Profile link"| profile
