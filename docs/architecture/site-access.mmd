---
title: Route access and write boundaries
---
flowchart LR
  accTitle: Book Tracker route access and write boundaries
  accDescr: Routes are grouped by their effective access boundary. Personal library and shared-work pages require sign-in, public profiles require publication, and admin routes require the fixed verified operator. Catalog mutations additionally require recent authentication.

  classDef actor fill:#f7f8f8,stroke:#8b9691,color:#263331,stroke-width:2px;
  classDef owner fill:#eaf7ef,stroke:#2e7d55,color:#17482f,stroke-width:2px;
  classDef public fill:#edf4f6,stroke:#497789,color:#173d4a,stroke-width:2px;
  classDef privileged fill:#fff7f6,stroke:#b42318,color:#651c15,stroke-width:2px;
  classDef security fill:#fff7e8,stroke:#b98a3c,color:#5b421f,stroke-width:2px;

  signedout["<b>Signed-out visitor</b>"]:::actor
  signedin["<b>Signed-in reader</b>"]:::actor
  operator["<b>Fixed verified operator</b>"]:::actor

  subgraph ownerpages[Signed-in owner and reader routes]
    direction TB
    current["<b>Currently Reading</b> · <code>/</code><br/>Owner book, progress, session, and timer writes"]:::owner
    finished["<b>Finished</b> · <code>/finished</code><br/>Owner book, progress, and session writes"]:::owner
    me["<b>My site</b> · <code>/me</code><br/>Profile, sharing consent, integrations, and books"]:::owner
    authors["<b>Authors</b> · <code>/authors</code><br/>Signed-in shared-catalog read<br/>owner book-reference writes"]:::owner
    isbns["<b>Book metadata</b> · <code>/isbns</code><br/>Owner metadata edits through the book dialog"]:::owner
    work["<b>Shared work</b> · <code>/books/[workId]</code><br/>Read-only callable projection of bibliography<br/>and explicitly opted-in reader summaries"]:::owner
  end

  profile["<b>Reading profile</b> · <code>/profiles/[username]</code><br/>Anyone when published; owner may read private<br/>No writes on the route"]:::public

  subgraph adminpages[Privileged routes]
    direction TB
    admin["<b>Admin overview</b> · <code>/admin</code><br/>Fixed UID + verified email<br/>read-only overview; server view audit"]:::privileged
    admincatalog["<b>Catalog curation</b> · <code>/admin/catalog</code><br/>Bounded scan and preview; recently authenticated<br/>apply of eight allowlisted operations"]:::privileged
  end

  login["<b>Authentication gate</b><br/>Private URL renders login/register,<br/>then resumes after authentication"]:::security
  enforcement["<b>Authoritative enforcement</b><br/>Firestore Rules for browser data<br/>callable authorization + IAM for Admin SDK"]:::security

  signedout --> login --> signedin
  signedout -->|"published only"| profile
  signedin --> ownerpages
  signedin -->|"published or owned"| profile
  operator --> admin --> admincatalog
  ownerpages -.-> enforcement
  profile -.-> enforcement
  adminpages -.-> enforcement
