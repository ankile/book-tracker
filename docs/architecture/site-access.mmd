  read_profile["Anyone when published<br/>owner through authenticated Firestore<br/>when private"]
  write_profile["None on this page<br/>owner edits profile on <code>/me</code>"]

  r_admin["<b>Admin overview</b><br/><code>/admin</code>"]
  reach_admin["Direct URL only"]
  read_admin["Fixed UID + verified email"]
  write_admin["No UI controls<br/>server writes <code>adminAudit</code>"]

  authnote:4["<b>Signed-out behavior</b> · A private URL renders login/register, then resumes that route after authentication. Unauthorized profile and admin requests disclose no private data."]
  securitynote:4["<b>Enforcement</b> · Route gates are user-interface behavior. Firestore Rules, callable handler checks, and IAM are the security boundaries."]

