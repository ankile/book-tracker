block-beta
  accTitle: Book Tracker route access and write matrix
  accDescr: A four-column matrix lists every application route, how it is reached, who can read it, and the data that can be changed from it. Private routes require the signed-in owner. Public profiles are readable when published, and the owner can also render a private profile through an authenticated Firestore read. The admin route is restricted to one verified operator.

  columns 4

  hroute["<b>Route</b>"] hreach["<b>Reached from</b>"] hread["<b>Read access</b>"] hwrite["<b>Writes available</b>"]

  r_current["<b>Currently Reading</b><br/><code>/</code>"]
  reach_current["Navbar · My site card · direct URL<br/>profile ‘Go to app’ link"]
  read_current["Owner"]
  write_current["Books · authors · page updates<br/>sessions · local/Toggl timers"]

  r_finished["<b>Finished</b><br/><code>/finished</code>"]
  reach_finished["Navbar · My site card · direct URL"]
  read_finished["Owner"]
  write_finished["Books · authors · page updates<br/>reading sessions"]

  r_me["<b>My site</b><br/><code>/me</code>"]
  reach_me["Navbar · direct URL"]
  read_me["Owner"]
  write_me["Add book · profile and discovery<br/>profile links · Toggl token"]

  r_authors["<b>Authors</b><br/><code>/authors</code>"]
  reach_authors["My site Authors card · direct URL"]
  read_authors["Owner"]
