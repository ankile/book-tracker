{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["@sveltejs/kit"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src/service-worker.ts"]
}
