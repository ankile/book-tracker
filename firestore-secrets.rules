rules_version = '2';
// The `secrets` Firestore database holds integration credentials
// (togglTokens/{uid}, SEC-004). No client — signed in or not — may ever
// read or write here; only the Admin SDK (the Toggl callables, the
// deletion trigger, operator scripts) touches it, and the internet-facing
// publicweb identity is excluded by an IAM condition on its read role
// (SEC-097). A browser SDK can address a named database with nothing but
// the public project config, so this deny-all must be deployed, never
// assumed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
