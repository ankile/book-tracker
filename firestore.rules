rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && userId == request.auth.uid;
    }
    // Own-user private data, but a signed-up stranger's too: every field a
    // client may write is allowlisted and byte-capped (SEC-039), so one
    // document is a few KB rather than the 1 MiB Firestore allows —
    // storage that PITR and 98 daily backups would multiply, and that a
    // delete event would carry in full into Pub/Sub (SEC-071). Progress and
    // timer updates only touch fields the transition rules already pin, so
    // they skip the shape check: the timer batch runs close to the rules
    // expression budget and must stay cheap.
    match /users/{userId}/books/{bookId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow create: if request.auth != null && userId == request.auth.uid
                    && validBookTitle()
                    && validInitialBookTimer()
                    && validBookPageState(request.resource.data)
                    && request.resource.data.get('currentPageUpdateId', null) == null
                    && validBookShape();
      allow update: if request.auth != null && userId == request.auth.uid
                    && validBookTitle()
                    && validBookTimerTransition(userId, bookId)
                    && validBookPageStateTransition()
                    && validBookProgressSourceTransition(userId, bookId)
                    && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'activeTimer', 'currentPage', 'currentPageUpdateId',
                           'pagesRead', 'timeRead', 'finished', 'updatedAt'
                         ])
                         && validBookProgressFields())
                        || validBookShape());
      // A local timer has no remote side effect. The UI explicitly warns
      // that its unsaved interval will be lost. Server-backed and uncertain
      // Toggl lifecycle states must be cleared through their stop/resolve path.
      allow delete: if request.auth != null && userId == request.auth.uid
                    && (resource.data.get('activeTimer', null) == null
                        || (validLocalTimer(resource.data.activeTimer)
                            && validDeletedLocalTimerClaim(userId, bookId)));

      // Writes are validated so a client cannot forge owner — which the
      // collectionGroup rule below trusts for cross-book stats reads — nor
      // point book at another document or invent an unknown type.
      match /updates/{updateId} {
        allow read: if request.auth != null && userId == request.auth.uid;
        allow create: if request.auth != null && userId == request.auth.uid
                      && validBookUpdateIdentity(userId, bookId)
                      && validNewBookUpdateShape()
                      && validCreatedBookUpdate(userId, bookId, updateId);
        allow update: if request.auth != null && userId == request.auth.uid
                      && validBookUpdateIdentity(userId, bookId)
                      && resource.data.type == 'reading'
                      && request.resource.data.type == resource.data.type
                      && validChangedReadingShape()
                      && validChangedBookUpdate(userId, bookId, updateId);
        allow delete: if request.auth != null && userId == request.auth.uid
                      && resource.data.type == 'reading'
                      && validDeletedBookUpdate(userId, bookId, updateId);
      }
    }

    match /users/{userId}/timerLifecycle/{lifecycleId} {
      allow read: if request.auth != null && userId == request.auth.uid
                  && lifecycleId == 'current';
      allow update: if request.auth != null && userId == request.auth.uid
                    && lifecycleId == 'current'
                    && validClientTimerClaimTransition(userId);
    }

    // The fields a progress or timer update may touch without the full
    // shape check are typed here, cheaply (get() with a default rather than
    // hasAny branches: this runs inside every timer batch, and the tightest
    // of them — the outcome-unknown clear — sits nearest the expression
    // budget). Page state types currentPage/pageCount/finished, the timer
    // transition types activeTimer, and the progress-source transition pins
    // currentPageUpdateId to an existing document id.
    function validBookProgressFields() {
      let book = request.resource.data;
      return book.get('updatedAt', request.time) is timestamp
             && book.get('pagesRead', 0) is number
             && book.get('timeRead', 0) is number;
    }

    // Field allowlist and byte caps for a book document (SEC-039). Lists
    // cannot be iterated in rules, so string lists are bounded through
    // join(): it throws on a non-string element, which is a denial.
    // size() counts UTF-16 code units, so a cap is up to three times as
    // many bytes for CJK text — still tens of KB per document, not the
    // 1 MiB Firestore allows. The pre-migration author/authors fields are
    // not admitted: no live document carries them (inventoried 2026-08-29)
    // and the client only ever deletes them, so an update that still holds
    // one must shed it — an uncapped list of maps was a 1 MiB channel.
    function validBookShape() {
      let book = request.resource.data;
      return book.keys().hasOnly([
               'activeTimer', 'authorIds', 'coverUrl', 'createdAt',
               'currentPage', 'currentPageUpdateId', 'fiction', 'finished', 'isbn',
               'owner', 'pageCount', 'pagesRead', 'timeRead', 'publishedDate',
               'publisher', 'subjects', 'title', 'updatedAt'
             ])
             // Absent on the oldest documents; typed when present.
             && book.get('updatedAt', request.time) is timestamp
             && (!book.keys().hasAny(['authorIds'])
                 || (book.authorIds is list && book.authorIds.size() <= 50
                     && book.authorIds.join('').size() <= 5000))
             && (!book.keys().hasAny(['coverUrl'])
                 || (book.coverUrl is string && book.coverUrl.size() <= 2048))
             && (!book.keys().hasAny(['publisher'])
                 || (book.publisher is string && book.publisher.size() <= 500))
             && (!book.keys().hasAny(['publishedDate'])
                 || (book.publishedDate is string && book.publishedDate.size() <= 64))
             && (!book.keys().hasAny(['subjects'])
                 || (book.subjects is list && book.subjects.size() <= 25
                     && book.subjects.join('').size() <= 2500))
             && (!book.keys().hasAny(['fiction'])
                 || book.fiction == null || book.fiction is bool)
             && (!book.keys().hasAny(['isbn'])
                 || (book.isbn is string && book.isbn.size() <= 32))
             && (!book.keys().hasAny(['owner'])
                 || book.owner == /databases/$(database)/documents/users/$(request.auth.uid))
             && (!book.keys().hasAny(['createdAt']) || book.createdAt is timestamp)
             && (!book.keys().hasAny(['pagesRead'])
                 || (book.pagesRead is number && book.pagesRead >= 0))
             && (!book.keys().hasAny(['timeRead'])
                 || (book.timeRead is number && book.timeRead >= 0))
             && (book.get('currentPageUpdateId', null) == null
                 || (book.currentPageUpdateId is string
                     && book.currentPageUpdateId.size() <= 100));
    }

    function validBookUpdateIdentity(userId, bookId) {
      return request.resource.data.owner == /databases/$(database)/documents/users/$(userId)
             && request.resource.data.book == /databases/$(database)/documents/users/$(userId)/books/$(bookId)
             && request.resource.data.type in ['reading', 'update'];
    }

    function validNewBookUpdateShape() {
      let entry = request.resource.data;
      return ((entry.type == 'reading'
               && entry.keys().hasAll([
                 'owner', 'book', 'type', 'timeRead', 'fromPage', 'toPage',
                 'pagesRead', 'updatedAt', 'createdAt'
               ])
               && entry.keys().hasOnly([
                 'owner', 'book', 'type', 'timeRead', 'fromPage', 'toPage',
                 'pagesRead', 'updatedAt', 'createdAt'
               ])
               && entry.timeRead is int
               && entry.timeRead > 0
               && entry.pagesRead >= 0
               && entry.toPage >= entry.fromPage)
              || (entry.type == 'update'
                  && entry.keys().hasAll([
                    'owner', 'book', 'type', 'fromPage', 'toPage', 'pagesRead',
                    'updatedAt', 'createdAt'
                  ])
                  && entry.keys().hasOnly([
                    'owner', 'book', 'type', 'fromPage', 'toPage', 'pagesRead',
                    'updatedAt', 'createdAt'
                  ])))
             && entry.fromPage is int
             && entry.fromPage >= 0
             && entry.fromPage <= 9007199254740991
             && entry.toPage is int
             && entry.toPage >= 0
             && entry.toPage <= 9007199254740991
             && entry.pagesRead is int
             && entry.pagesRead >= -9007199254740991
             && entry.pagesRead <= 9007199254740991
             && entry.pagesRead == entry.toPage - entry.fromPage
             && entry.updatedAt is timestamp
             && entry.createdAt is timestamp;
    }

    function validChangedReadingShape() {
      let before = resource.data;
      let after = request.resource.data;
      return after.keys().hasAll([
               'owner', 'book', 'type', 'timeRead', 'fromPage', 'toPage',
               'pagesRead', 'updatedAt', 'createdAt'
             ])
             && after.keys().hasOnly([
               'owner', 'book', 'type', 'timeRead', 'fromPage', 'toPage',
               'pagesRead', 'updatedAt', 'createdAt'
             ])
             && after.diff(before).affectedKeys().hasOnly([
               'timeRead', 'toPage', 'pagesRead', 'updatedAt'
             ])
             && after.owner == before.owner
             && after.book == before.book
             && after.type == before.type
             && after.createdAt == before.createdAt
             && after.fromPage == before.fromPage
             && after.fromPage is int
             && after.fromPage >= 0
             && after.fromPage <= 9007199254740991
             && after.toPage is int
             && after.toPage > after.fromPage
             && after.toPage <= 9007199254740991
             && after.pagesRead is int
             && after.pagesRead >= 0
             && after.pagesRead <= 9007199254740991
             && after.pagesRead == after.toPage - after.fromPage
             && after.timeRead is int
             && after.timeRead > 0
             && after.updatedAt is timestamp;
    }

    // Every update row and its denormalized book aggregates move in one
    // batch. getAfter makes a stale offline edit fail atomically after a
    // different client has already changed the same session, while increment
    // transforms from edits to different sessions continue to commute.
    function validCreatedBookUpdate(userId, bookId, updateId) {
      let before = get(/databases/$(database)/documents/users/$(userId)/books/$(bookId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)).data;
      let entry = request.resource.data;
      return ((entry.type == 'reading'
               && after.get('pagesRead', 0) == before.get('pagesRead', 0) + entry.pagesRead
               && after.get('timeRead', 0) == before.get('timeRead', 0) + entry.timeRead)
              || (entry.type == 'update'
                  && after.get('pagesRead', 0) == before.get('pagesRead', 0)
                  && after.get('timeRead', 0) == before.get('timeRead', 0)))
             && entry.fromPage == before.currentPage
             && after.currentPage == entry.toPage
             && ((before.keys().hasAny(['currentPageUpdateId'])
                  && after.currentPageUpdateId == updateId)
                 || (!before.keys().hasAny(['currentPageUpdateId'])
                     && (after.get('currentPageUpdateId', null) == null
                         || after.currentPageUpdateId == updateId)))
             && (validCorrelatedBook(before, after)
                 || (entry.type == 'update'
                     && validPageCountClampBook(before, after, entry)));
    }

    function validChangedBookUpdate(userId, bookId, updateId) {
      let before = get(/databases/$(database)/documents/users/$(userId)/books/$(bookId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)).data;
      let oldEntry = resource.data;
      let newEntry = request.resource.data;
      return after.get('pagesRead', 0) == before.get('pagesRead', 0) + newEntry.pagesRead - oldEntry.pagesRead
             && after.get('timeRead', 0) == before.get('timeRead', 0) + newEntry.timeRead - oldEntry.timeRead
             && ((before.get('currentPageUpdateId', null) == updateId
                  && after.currentPage == newEntry.toPage
                  && after.currentPageUpdateId == updateId)
                 || (before.get('currentPageUpdateId', null) != updateId
                     && after.currentPage == before.currentPage
                     && after.get('currentPageUpdateId', null)
                        == before.get('currentPageUpdateId', null)))
             && newEntry.toPage <= after.pageCount
             && validCorrelatedBook(before, after);
    }

    function validDeletedBookUpdate(userId, bookId, updateId) {
      let before = get(/databases/$(database)/documents/users/$(userId)/books/$(bookId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)).data;
      let entry = resource.data;
      return after.get('pagesRead', 0) == before.get('pagesRead', 0) - entry.pagesRead
             && after.get('timeRead', 0) == before.get('timeRead', 0) - entry.timeRead
             && ((before.get('currentPageUpdateId', null) == updateId
                  && after.currentPage == entry.fromPage
                  && (after.get('currentPageUpdateId', null) == null
                      || validSurvivingProgressSource(
                           userId, bookId, updateId,
                           after.get('currentPageUpdateId', null), after.currentPage
                         )))
                 || (before.get('currentPageUpdateId', null) != updateId
                     && after.currentPage == before.currentPage
                     && after.get('currentPageUpdateId', null)
                        == before.get('currentPageUpdateId', null)))
             && validCorrelatedBook(before, after);
    }

    function validSurvivingProgressSource(userId, bookId, deletedId, sourceId, page) {
      return sourceId is string
             && sourceId != deletedId
             && existsAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(sourceId))
             && getAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(sourceId)).data.toPage
                == page;
    }

    function validCorrelatedBook(before, after) {
      let pagesRead = after.get('pagesRead', 0);
      let timeRead = after.get('timeRead', 0);
      return after.diff(before).affectedKeys().hasOnly([
               'pagesRead', 'timeRead', 'currentPage', 'currentPageUpdateId',
               'finished', 'updatedAt'
             ])
             && pagesRead is int
             && pagesRead >= 0
             && timeRead is int
             && timeRead >= 0
             && after.currentPage is int
             && after.currentPage >= 0
             && after.currentPage <= 9007199254740991
             && after.pageCount is int
             && after.pageCount > 0
             && after.pageCount <= 9007199254740991
             && after.currentPage <= after.pageCount
             && after.get('finished', after.currentPage == after.pageCount)
                == (after.currentPage == after.pageCount)
             && (after.get('currentPageUpdateId', null) == null
                 || after.currentPageUpdateId is string)
             && after.updatedAt is timestamp;
    }

    // Editing metadata may shrink pageCount below the rendered currentPage,
    // or encounter a legacy book whose page is already beyond its count. The
    // client records that repair as a page-correction row, and the common
    // create checks above pin entry.fromPage to the server's current page.
    // That makes an offline stale repair reject atomically after a newer read.
    function validPageCountClampBook(before, after, entry) {
      return after.diff(before).affectedKeys().hasOnly([
               'authorIds', 'author', 'authors', 'title', 'pageCount',
               'currentPage', 'currentPageUpdateId', 'finished', 'isbn',
               'coverUrl', 'publisher', 'publishedDate', 'subjects',
               'fiction', 'updatedAt'
             ])
             && after.pageCount is int
             && after.pageCount > 0
             && after.pageCount <= 9007199254740991
             && before.currentPage > after.pageCount
             && after.currentPage == after.pageCount
             && entry.toPage == after.pageCount
             && after.finished == true
             && after.updatedAt is timestamp;
    }

    // The callable owns Toggl lifecycle maps. Clients may start/stop a
    // local timer, clear a confirmed unknown outcome, or clear an ordinary
    // remote timer while queuing its offline stop. They cannot forge or
    // erase a start claim while the server may be issuing the remote POST.
    function validInitialBookTimer() {
      let timer = request.resource.data.get('activeTimer', null);
      return timer == null;
    }

    function validBookProgressSourceTransition(userId, bookId) {
      let beforeHasSource = resource.data.keys().hasAny(['currentPageUpdateId']);
      let beforePage = resource.data.get('currentPage', null);
      let afterPage = request.resource.data.get('currentPage', null);
      let beforeSource = resource.data.get('currentPageUpdateId', null);
      let afterSource = request.resource.data.get('currentPageUpdateId', null);
      return (afterPage == beforePage
              && afterSource == beforeSource)
             || (afterSource is string
                 && existsAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(afterSource))
                 && getAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(afterSource)).data.toPage
                    == afterPage
                 && (!exists(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(afterSource))
                     || (afterSource == beforeSource
                         && getAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(afterSource)).data
                            != get(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(afterSource)).data)))
             || (beforeSource is string
                 && !existsAfter(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(beforeSource))
                 && get(/databases/$(database)/documents/users/$(userId)/books/$(bookId)/updates/$(beforeSource)).data.fromPage
                    == afterPage
                 && (afterSource == null
                     || validSurvivingProgressSource(
                          userId, bookId, beforeSource, afterSource, afterPage
                        )))
             // Old cached clients know nothing about the source field. Keep
             // them working only for genuinely legacy books where the field
             // is absent; explicit-null new books require a source on their
             // first progress write.
             || (!beforeHasSource && beforeSource == null && afterSource == null);
    }

    // Unrelated edits remain possible on old partial documents. Creating or
    // changing page state, however, must leave one complete, JS-safe state.
    function validBookPageStateTransition() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'currentPage', 'pageCount', 'finished'
             ])
             || validBookPageState(request.resource.data);
    }

    function validBookPageState(book) {
      return book.keys().hasAll([
               'currentPage', 'pageCount', 'finished', 'updatedAt'
             ])
             && book.currentPage is int
             && book.currentPage >= 0
             && book.currentPage <= 9007199254740991
             && book.pageCount is int
             && book.pageCount > 0
             && book.pageCount <= 9007199254740991
             && book.currentPage <= book.pageCount
             && book.finished == (book.currentPage == book.pageCount)
             && book.updatedAt is timestamp;
    }

    function validBookTitle() {
      return request.resource.data.title is string
             && request.resource.data.title.size() > 0
             && request.resource.data.title.size() <= 500;
    }

    function validBookTimerTransition(userId, bookId) {
      let before = resource.data.get('activeTimer', null);
      let after = request.resource.data.get('activeTimer', null);
      return before == after
             || validChangedBookTimerTransition(userId, bookId, before, after);
    }

    function validChangedBookTimerTransition(userId, bookId, before, after) {
      let claimPath = /databases/$(database)/documents/users/$(userId)/timerLifecycle/current;
      let beforeClaim = get(claimPath).data;
      let afterClaim = getAfter(claimPath).data;
      return (before == null
                 && validLocalTimer(after)
                 && validIdleTimerClaim(beforeClaim)
                 && localClaimMatchesTimer(afterClaim, bookId, after))
             || (after == null
                 && ((validLocalTimer(before)
                      && localClaimMatchesTimer(beforeClaim, bookId, before))
                     || (validUnknownTimer(before)
                         && unknownClaimMatchesTimer(beforeClaim, bookId, before)))
                 && validClearedTimerClaim(afterClaim, beforeClaim))
             || (validRemoteTimer(before)
                 && validStoppingTimer(after)
                 && remoteClaimMatchesTimer(beforeClaim, bookId, before)
                 && validStoppingTimerClaim(afterClaim)
                 && afterClaim.bookId == bookId
                 && afterClaim.entryId == after.entryId
                 && afterClaim.start == after.start
                 && afterClaim.queueId == after.queueId);
    }

    function validLocalTimer(timer) {
      return timer is map
             && timer.keys().hasAll(['start', 'operationId'])
             && timer.keys().hasOnly(['start', 'operationId'])
             && validTimerStart(timer.start)
             && timer.operationId is string
             && timer.operationId.size() > 0
             && timer.operationId.size() <= 100;
    }

    function validRemoteTimer(timer) {
      return timer is map
             && timer.keys().hasAll(['entryId', 'start'])
             && timer.keys().hasOnly(['entryId', 'start'])
             && timer.entryId is int
             && timer.entryId > 0
             && validTimerStart(timer.start);
    }

    function validUnknownTimer(timer) {
      return timer is map
             && timer.keys().hasAll([
                  'state', 'operationId', 'start', 'claimedAt', 'error'
                ])
             && timer.keys().hasOnly([
                  'state', 'operationId', 'start', 'claimedAt', 'error'
                ])
             && timer.state == 'outcome-unknown'
             && timer.operationId is string
             && timer.operationId.size() > 0
             && timer.operationId.size() <= 100
             && validTimerStart(timer.start)
             && timer.claimedAt is timestamp
             && timer.error is string
             && timer.error.size() > 0
             && timer.error.size() <= 1000;
    }

    function validStoppingTimer(timer) {
      return timer is map
             && timer.keys().hasAll(['state', 'entryId', 'start', 'queueId'])
             && timer.keys().hasOnly(['state', 'entryId', 'start', 'queueId'])
             && timer.state == 'stopping'
             && timer.entryId is int
             && timer.entryId > 0
             && validTimerStart(timer.start)
             && timer.queueId is string
             // One document id: no slash, the server interpolates it into a
             // path (SEC-040).
             && timer.queueId.matches('[^/]{1,600}');
    }

    function validIdleTimerClaim(claim) {
      return claim is map
             && claim.keys().hasAll(['version', 'state', 'cleared'])
             && claim.keys().hasOnly(['version', 'state', 'cleared'])
             && claim.version == 1
             && claim.state == 'idle'
             && (claim.cleared == null || validActiveTimerClaim(claim.cleared));
    }

    function validClearedTimerClaim(after, before) {
      return validIdleTimerClaim(after) && after.cleared == before;
    }

    function validActiveTimerClaim(claim) {
      return validLocalTimerClaim(claim)
             || validRemoteTimerClaim(claim)
             || validStartingTimerClaim(claim)
             || validUnknownTimerClaim(claim)
             || validStoppingTimerClaim(claim);
    }

    function validClaimBookId(claim) {
      return claim.version == 1
             && claim.bookId is string
             && claim.bookId.size() > 0
             && claim.bookId.size() <= 500
             && !claim.bookId.matches('.*[/].*')
             && claim.bookId != '.'
             && claim.bookId != '..';
    }

    function validLocalTimerClaim(claim) {
      return claim is map
             && claim.keys().hasAll(['version', 'state', 'bookId', 'operationId', 'start'])
             && claim.keys().hasOnly(['version', 'state', 'bookId', 'operationId', 'start'])
             && validClaimBookId(claim)
             && claim.state == 'local'
             && claim.operationId is string
             && claim.operationId.size() > 0
             && claim.operationId.size() <= 100
             && validTimerStart(claim.start);
    }

    function validRemoteTimerClaim(claim) {
      return claim is map
             && claim.keys().hasAll(['version', 'state', 'bookId', 'entryId', 'start'])
             && claim.keys().hasOnly(['version', 'state', 'bookId', 'entryId', 'start'])
             && validClaimBookId(claim)
             && claim.state == 'remote'
             && claim.entryId is int
             && claim.entryId > 0
             && validTimerStart(claim.start);
    }

    function validStartingTimerClaim(claim) {
      return claim is map
             && claim.keys().hasAll(['version', 'state', 'bookId', 'operationId', 'start', 'claimedAt'])
             && claim.keys().hasOnly(['version', 'state', 'bookId', 'operationId', 'start', 'claimedAt'])
             && validClaimBookId(claim)
             && claim.state == 'starting'
             && claim.operationId is string
             && claim.operationId.size() > 0
             && claim.operationId.size() <= 100
             && validTimerStart(claim.start)
             && claim.claimedAt is timestamp;
    }

    function validUnknownTimerClaim(claim) {
      return claim is map
             && claim.keys().hasAll(['version', 'state', 'bookId', 'operationId', 'start', 'claimedAt', 'error'])
             && claim.keys().hasOnly(['version', 'state', 'bookId', 'operationId', 'start', 'claimedAt', 'error'])
             && validClaimBookId(claim)
             && claim.state == 'outcome-unknown'
             && claim.operationId is string
             && claim.operationId.size() > 0
             && claim.operationId.size() <= 100
             && validTimerStart(claim.start)
             && claim.claimedAt is timestamp
             && claim.error is string
             && claim.error.size() > 0
             && claim.error.size() <= 1000;
    }

    function validStoppingTimerClaim(claim) {
      return claim is map
             && claim.keys().hasAll(['version', 'state', 'bookId', 'entryId', 'start', 'queueId'])
             && claim.keys().hasOnly(['version', 'state', 'bookId', 'entryId', 'start', 'queueId'])
             && validClaimBookId(claim)
             && claim.state == 'stopping'
             && claim.entryId is int
             && claim.entryId > 0
             && validTimerStart(claim.start)
             && claim.queueId is string
             // One document id: no slash, the server interpolates it into a
             // path (SEC-040).
             && claim.queueId.matches('[^/]{1,600}');
    }

    function validTimerStart(start) {
      return start is string
             && start.size() > 0
             && start.size() <= 64
             && start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})');
    }

    function localClaimMatchesTimer(claim, bookId, timer) {
      return validLocalTimerClaim(claim)
             && validLocalTimer(timer)
             && claim.bookId == bookId
             && claim.operationId == timer.operationId
             && claim.start == timer.start;
    }

    function remoteClaimMatchesTimer(claim, bookId, timer) {
      return validRemoteTimerClaim(claim)
             && validRemoteTimer(timer)
             && claim.bookId == bookId
             && claim.entryId == timer.entryId
             && claim.start == timer.start;
    }

    function unknownClaimMatchesTimer(claim, bookId, timer) {
      return validUnknownTimerClaim(claim)
             && validUnknownTimer(timer)
             && claim.bookId == bookId
             && claim.operationId == timer.operationId
             && claim.start == timer.start
             && claim.claimedAt == timer.claimedAt
             && claim.error == timer.error;
    }

    function validClientTimerClaimTransition(userId) {
      let before = resource.data;
      let after = request.resource.data;
      return (validIdleTimerClaim(before)
              && validLocalTimerClaim(after)
              && validLocalBookStart(userId, after))
             || (validLocalTimerClaim(before)
                 && validClearedTimerClaim(after, before)
                 && validLocalBookClear(userId, before))
             || (validUnknownTimerClaim(before)
                 && validClearedTimerClaim(after, before)
                 && validUnknownBookClear(userId, before))
             || (validRemoteTimerClaim(before)
                 && validStoppingTimerClaim(after)
                 && validRemoteBookStopQueue(userId, before, after));
    }

    function validLocalBookStart(userId, claim) {
      let path = /databases/$(database)/documents/users/$(userId)/books/$(claim.bookId);
      return exists(path)
             && get(path).data.get('activeTimer', null) == null
             && localClaimMatchesTimer(
                  claim, claim.bookId, getAfter(path).data.activeTimer
                );
    }

    function validLocalBookClear(userId, claim) {
      let path = /databases/$(database)/documents/users/$(userId)/books/$(claim.bookId);
      return exists(path)
             && localClaimMatchesTimer(claim, claim.bookId, get(path).data.activeTimer)
             && (!existsAfter(path)
                 || getAfter(path).data.get('activeTimer', null) == null);
    }

    function validUnknownBookClear(userId, claim) {
      let path = /databases/$(database)/documents/users/$(userId)/books/$(claim.bookId);
      return exists(path)
             && existsAfter(path)
             && unknownClaimMatchesTimer(claim, claim.bookId, get(path).data.activeTimer)
             && getAfter(path).data.get('activeTimer', null) == null;
    }

    function validRemoteBookStopQueue(userId, before, after) {
      let path = /databases/$(database)/documents/users/$(userId)/books/$(before.bookId);
      let queuePath = /databases/$(database)/documents/users/$(userId)/togglQueue/$(after.queueId);
      let item = getAfter(queuePath).data;
      return before.bookId == after.bookId
             && before.entryId == after.entryId
             && before.start == after.start
             && after.queueId == before.bookId + '_' + before.start
             && exists(path)
             && existsAfter(path)
             && validRemoteTimer(get(path).data.activeTimer)
             && get(path).data.activeTimer.entryId == before.entryId
             && get(path).data.activeTimer.start == before.start
             && validStoppingTimer(getAfter(path).data.activeTimer)
             && getAfter(path).data.activeTimer.entryId == after.entryId
             && getAfter(path).data.activeTimer.start == after.start
             && getAfter(path).data.activeTimer.queueId == after.queueId
             && existsAfter(queuePath)
             && item.type == 'stop'
             && item.timerClaimVersion == 1
             && item.bookId == before.bookId
             && item.entryId == before.entryId
             && item.start == before.start;
    }

    function validDeletedLocalTimerClaim(userId, bookId) {
      let path = /databases/$(database)/documents/users/$(userId)/timerLifecycle/current;
      let before = get(path).data;
      let after = getAfter(path).data;
      return localClaimMatchesTimer(before, bookId, resource.data.activeTimer)
             && validClearedTimerClaim(after, before);
    }
    // Author entities, written in the same client batch as the book that
    // references them. Own-user private data, so books-level strictness
    // applies (the validation-heavy style is for anonymous surfaces).
    // Author entities: allowlisted and capped like books (SEC-039). No
    // delete rule by design — a book written offline may still reference
    // the id, so authors retire instead (validAuthorRetirementTransition).
    match /users/{userId}/authors/{authorId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow create: if request.auth != null && userId == request.auth.uid
                    && !request.resource.data.keys().hasAny(['retirement'])
                    && validAuthorShape();
      allow update: if request.auth != null && userId == request.auth.uid
                    && validAuthorRetirementTransition(userId, authorId)
                    && validAuthorShape();
    }

    function validAuthorShape() {
      let author = request.resource.data;
      return author.keys().hasOnly([
               'name', 'nameLower', 'kind', 'givenName', 'familyName', 'retirement', 'updatedAt'
             ])
             && author.name is string
             && author.name.size() > 0
             && author.name.size() <= 200
             && (!author.keys().hasAny(['nameLower'])
                 || (author.nameLower is string && author.nameLower.size() <= 200))
             && (!author.keys().hasAny(['kind'])
                 || author.kind in ['person', 'entity', 'placeholder'])
             && (!author.keys().hasAny(['givenName'])
                 || (author.givenName is string && author.givenName.size() <= 100))
             && (!author.keys().hasAny(['familyName'])
                 || (author.familyName is string && author.familyName.size() <= 100))
             && (!author.keys().hasAny(['updatedAt']) || author.updatedAt is timestamp)
             // The retirement transition pins the map's shape on each legal
             // transition; this bounds it on every write regardless.
             && (!author.keys().hasAny(['retirement'])
                 || (author.retirement is map
                     && author.retirement.keys().hasOnly(['reason', 'targetId'])
                     && author.retirement.reason in ['deleted', 'merged']
                     && author.retirement.get('targetId', '') is string
                     && author.retirement.get('targetId', '').size() <= 100));
    }

    function validAuthorRetirementTransition(userId, authorId) {
      let before = resource.data.get('retirement', null);
      let after = request.resource.data.get('retirement', null);
      return before == after
             || (before is map
                 && before.reason == 'deleted'
                 && after == null)
             || (before == null
                 && after is map
                 && ((after.keys().hasAll(['reason'])
                      && after.keys().hasOnly(['reason'])
                      && after.reason == 'deleted')
                     || (after.keys().hasAll(['reason', 'targetId'])
                         && after.keys().hasOnly(['reason', 'targetId'])
                         && after.reason == 'merged'
                         && after.targetId is string
                         && after.targetId != authorId
                         && get(/databases/$(database)/documents/users/$(userId)/authors/$(after.targetId)).data.get('retirement', null) == null)));
    }

    // Offline Toggl sync queue: the only row a client can create is the
    // atomic offline-stop row — the deterministic `bookId_start` row written
    // in the same batch that clears that exact timer (SEC-002: ordinary
    // creates, which the client stopped writing on 2026-08-24, are gone, so
    // no client can mint a queue row that is not coupled to a real timer
    // clear). An owner can read its lifecycle; the Admin SDK alone writes
    // processing, error and synced states. A client retry can only set
    // pending plus a new server timestamp, only after the same stale
    // windows the client sweep uses, never before a server-pinned deferral
    // has ended, and never after the fifth claim. The timestamp makes a
    // retry of an unchanged pending status emit a production Firestore
    // event.
    //
    // Two server-owned counters bound the queue. functionQuotas/togglQueue
    // meters remote Toggl calls (ten per hour); an over-quota row is
    // deferred, not refused, so an offline stop never rolls its timer back
    // and its interval is never lost. functionQuotas/togglQueueRows counts
    // rows themselves (sixty per hour, moved by the trigger the first time
    // it touches a row) and closes this create rule once full: a client can
    // start and stop timers as fast as it likes, so without it one account
    // yields unlimited rows and Eventarc deliveries. The count lags the
    // writes by one delivery, so a burst overshoots but cannot sustain; a
    // refused stop leaves the timer running. Retry writes bypass both: the
    // server claim transaction remains the authoritative gate, and the
    // marker plus the deferral limit a stuck row to one delivery request
    // per ten-minute window and one per quota window respectively.
    match /users/{userId}/togglQueue/{queueId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow create: if request.auth != null && userId == request.auth.uid
                    && togglConfigured(userId)
                    && validInitialTogglQueueItem()
                    && request.resource.data.get('timerClaimVersion', 0) == 1
                    && validAtomicTimerStop(userId, queueId)
                    && togglQueueRowsAvailable(userId);
      allow update: if request.auth != null && userId == request.auth.uid
                    && togglConfigured(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'retryRequestedAt'])
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasAll(['retryRequestedAt'])
                    && togglRetryMarkerOpen()
                    && request.resource.data.status == 'pending'
                    && validRetryTogglQueueItem()
                    && resource.data.get('attempts', 0) < 5
                    && togglRetryWindowOpen();
    }

    // createdAt stays client-chosen (an offline stop is recorded with the
    // device clock) but may not run ahead of the server by more than the
    // skew allowance: the retry window and the deferred row's expiry are
    // both measured from it, and a forward-dated row was re-armable at
    // once and, once deferred, TTL-immortal.
    function validInitialTogglQueueItem() {
      let item = request.resource.data;
      return validTogglQueuePayload(item)
             && item.status == 'pending'
             && item.createdAt is timestamp
             && item.createdAt <= request.time + duration.value(300, 's')
             && item.keys().hasOnly([
                  'type', 'bookId', 'bookTitle', 'start', 'stop', 'entryId',
                  'timerClaimVersion', 'status', 'createdAt'
                ]);
    }

    function validRetryTogglQueueItem() {
      let item = request.resource.data;
      return validTogglQueuePayload(item)
             && item.status == 'pending'
             && item.createdAt is timestamp
             && item.retryRequestedAt is timestamp
             && item.retryRequestedAt == request.time
             && item.keys().hasOnly([
                  'type', 'bookId', 'bookTitle', 'start', 'stop', 'entryId',
                  'timerClaimVersion', 'status', 'createdAt', 'attempts', 'claimedAt', 'error',
                  'expiresAt', 'retryRequestedAt', 'deferredUntil', 'deferrals'
                ])
             && ((!item.keys().hasAny(['attempts', 'claimedAt', 'error']))
                  || (item.attempts is int
                      && item.attempts > 0
                      && item.attempts < 5
                      && item.claimedAt is timestamp
                      // The update rule pins affectedKeys to status and
                      // retryRequestedAt, so error can never change here;
                      // only its type is worth asserting.
                      && (!item.keys().hasAny(['error']) || item.error is string)));
    }

    function validTogglQueuePayload(item) {
      return item.keys().hasAll([
               'type', 'bookTitle', 'start', 'stop', 'status', 'createdAt'
             ])
             && item.type in ['create', 'stop']
             && (!item.keys().hasAny(['timerClaimVersion'])
                 || item.timerClaimVersion == 1)
             && (!item.keys().hasAny(['bookId'])
                  || (item.bookId is string
                      && item.bookId.matches('[^/]{1,500}')
                      && item.bookId != '.'
                      && item.bookId != '..'))
             && item.bookTitle is string
             && item.bookTitle.size() > 0
             && item.bookTitle.size() <= 500
             && item.start is string
             && item.start.size() > 0
             && item.start.size() <= 64
             && item.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})')
             && item.stop is string
             && item.stop.size() > 0
             && item.stop.size() <= 64
             && item.stop.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})')
             && (item.type == 'create'
                  ? !item.keys().hasAny(['entryId'])
                  : (item.keys().hasAll(['entryId'])
                     && item.entryId is int
                     && item.entryId > 0));
    }

    // The one client-creatable queue row: the deterministic row written in
    // the same batch that clears that exact timer. A full claim quota must
    // not make an offline stop roll its book timer back, so the remote-call
    // quota is not consulted here; the row counter is (see the match).
    function validAtomicTimerStop(userId, queueId) {
      let item = request.resource.data;
      let bookId = item.get('bookId', '');
      let path = /databases/$(database)/documents/users/$(userId)/books/$(bookId);
      let claimPath = /databases/$(database)/documents/users/$(userId)/timerLifecycle/current;
      let before = get(path).data;
      let after = getAfter(path).data;
      let timer = before.get('activeTimer', null);
      let beforeClaim = get(claimPath).data;
      let afterClaim = getAfter(claimPath).data;
      return item.keys().hasAll(['bookId'])
             && item.timerClaimVersion == 1
             && queueId == bookId + '_' + item.start
             && exists(path)
             && ((item.type == 'create'
                  && validLocalTimer(timer)
                  && timer.start == item.start
                  && localClaimMatchesTimer(beforeClaim, bookId, timer)
                  && after.get('activeTimer', null) == null
                  && validClearedTimerClaim(afterClaim, beforeClaim))
                 || (item.type == 'stop'
                     && validRemoteTimer(timer)
                     && timer.entryId == item.entryId
                     && timer.start == item.start
                     && validRemoteTimerClaim(beforeClaim)
                     && beforeClaim.bookId == bookId
                     && beforeClaim.entryId == timer.entryId
                     && beforeClaim.start == timer.start
                     && validStoppingTimer(after.activeTimer)
                     && after.activeTimer.queueId == queueId
                     && validStoppingTimerClaim(afterClaim)
                     && afterClaim.bookId == bookId
                     && afterClaim.entryId == after.activeTimer.entryId
                     && afterClaim.start == after.activeTimer.start
                     && afterClaim.queueId == after.activeTimer.queueId));
    }

    // A row the server deferred (quota window full) carries the
    // server-pinned end of that window; no retry marker before it, so a
    // deferred row costs one delivery per window instead of six. The
    // trigger only stamps pending rows and clears the stamp on every
    // transition, but the gate covers every branch rather than trust that.
    function togglRetryWindowOpen() {
      return togglDeferralEnded()
             && (resource.data.status == 'error'
             || (resource.data.status == 'pending'
                 && resource.data.createdAt is timestamp
                 && resource.data.createdAt
                    < request.time - duration.value(600, 's'))
             || (resource.data.status == 'processing'
                 && resource.data.claimedAt is timestamp
                 && resource.data.claimedAt
                    < request.time - duration.value(21600, 's')));
    }

    function togglDeferralEnded() {
      return !resource.data.keys().hasAny(['deferredUntil'])
             || (resource.data.deferredUntil is timestamp
                 && resource.data.deferredUntil <= request.time);
    }

    // A pending retry marker suppresses duplicate Eventarc deliveries during
    // the normal lost-event recovery window. If no function claims it, let a
    // later sweep refresh the timestamp so the unchanged pending row emits a
    // new write event. The strict boundary matches the client sweep.
    function togglRetryMarkerOpen() {
      return !resource.data.keys().hasAny(['retryRequestedAt'])
             || (resource.data.retryRequestedAt is timestamp
                 && resource.data.retryRequestedAt
                    < request.time - duration.value(600, 's'));
    }

    function togglConfigured(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      let toggl = get(path).data.get('toggl', null);
      return exists(path)
             && toggl is map
             && toggl.keys().hasAll(['apiToken', 'workspaceId', 'projectId'])
             && toggl.keys().hasOnly(['apiToken', 'workspaceId', 'projectId'])
             && toggl.apiToken is string
             && toggl.apiToken.size() > 0
             && toggl.workspaceId is int
             && toggl.workspaceId > 0
             && toggl.projectId is int
             && toggl.projectId > 0;
    }

    // Mirrors functions/src/togglQueueLimits.ts (TOGGL_QUEUE_ROW_LIMIT,
    // TOGGL_QUEUE_WINDOW_MS) and the shape applyQuota writes. Only the Admin
    // SDK can write the counter, so a malformed document is a server bug and
    // fails closed here; a missing or expired one is an open window.
    function togglQueueRowsAvailable(userId) {
      let path = /databases/$(database)/documents/users/$(userId)/functionQuotas/togglQueueRows;
      return !exists(path)
             || (get(path).data.keys().hasAll(['windowStartedAt', 'count'])
                 && get(path).data.keys().hasOnly(['windowStartedAt', 'count'])
                 && get(path).data.windowStartedAt is timestamp
                 && get(path).data.count is int
                 && get(path).data.count >= 0
                 && (get(path).data.windowStartedAt
                       <= request.time - duration.value(3600, 's')
                     || get(path).data.count < 60));
    }

    // A separate marker opts an already-public profile into search. Keeping
    // this outside the profile doc matters for cached clients: they replace
    // profile docs wholesale, but know nothing about this collection and
    // therefore cannot erase a newer search choice. Client list is forbidden;
    // the server-side sitemap enumerates markers with the Admin SDK.
    // Publishing to the public web — a profile page, and its discovery
    // marker that puts it in the shared sitemap — is for verified accounts
    // whose users document still exists (SEC-033, SEC-062): sign-up is open
    // and unverified, and an account deleted in Auth keeps a valid ID token
    // for up to an hour, so without both checks anyone could plant an
    // indexable page under a name nobody could later delete.
    // A deleted account is tombstoned, not removed (SEC-006): its users
    // document stays with deletedAt set, and for the hour its ID token
    // outlives it the identity must not publish. A missing document is a
    // null-value error here, which denies — the same outcome exists() gave.
    // The account is not tombstoned (SEC-006). A missing users document is
    // a null-value error here, which denies — a live account always has
    // one (the sign-up trigger creates it and soft-delete keeps it).
    function accountLive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deletedAt', null) == null;
    }
    function verifiedAccount() {
      return request.auth.token.get('email_verified', false) == true
             && accountLive();
    }

    match /profileDiscovery/{username} {
      allow get: if request.auth != null
                 && get(/databases/$(database)/documents/profiles/$(username)).data.uid
                    == request.auth.uid;
      allow list: if false;
      allow create: if request.auth != null
                    && verifiedAccount()
                    && username.matches('[a-z0-9-]{3,30}')
                    && request.resource.data.keys().hasAll(['uid', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    // Server-pinned: the public sitemap scan orders markers by
                    // createdAt, oldest first, so a client-chosen (backdated)
                    // value could sort a seeded marker ahead of real profiles.
                    && request.resource.data.createdAt == request.time
                    && ownsPublicProfileAfter(username);
      allow update: if false;
      // Own marker first: a batched write may make at most 20 document
      // accesses, and the discoverable rename batch touches six documents
      // through these rules, so the honest path must stay cheap.
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || (exists(/databases/$(database)/documents/profiles/$(username))
                            && get(/databases/$(database)/documents/profiles/$(username)).data.uid
                               == request.auth.uid));
    }

    function ownsPublicProfileAfter(username) {
      let profile = getAfter(/databases/$(database)/documents/profiles/$(username)).data;
      return profile.uid == request.auth.uid && profile.public == true;
    }

    // Opt-in public profile pages: /profiles/<username> renders this doc.
    // The `public` flag decides whether the publicweb function will serve
    // it; the document itself is readable only by its owner. Public profiles
    // reach everyone through that function (Admin SDK, CDN- and
    // instance-cached HTML plus /profiles/<username>.json without the
    // uid). Letting anonymous clients get the raw doc handed any requester
    // an uncached, uncapped ~700 KB read with no credential and exposed the
    // owner's Firebase uid (SEC-019). Any profile that is not the caller's
    // own — public, private, or missing — reads as permission-denied, which
    // the client renders as not-found so no read path leaks username
    // existence. (A get on a missing doc also lands here as an evaluation
    // error → denied, deliberately the same signal.) The write path
    // necessarily does leak it: a create on a taken name fails and on a
    // free name succeeds — inherent to a first-writer-wins namespace; the
    // per-uid cap that bounds squatting is SEC-032. `list` is
    // owner-only — the Me page finds its own doc by querying on uid, and
    // strangers must not be able to enumerate usernames. The username is
    // the doc id, so uniqueness is first-writer-wins: a create against an
    // existing doc evaluates as an update and fails the uid pin. Publicly
    // rendered surface, so the validation-heavy style applies: the shape
    // is pinned so the doc can only ever hold aggregate reading numbers
    // plus two deliberately short name parts (givenName/familyName, the
    // app-wide person-name convention) — nothing a profile link could be
    // used to host arbitrary content on.
    //
    // One profile per account (SEC-032): profileOwners/{uid} names the one
    // username an account holds, and every profile create, rename and
    // delete must move it in the same batch — a second profile would need
    // the first one gone. That is also what makes a freed username's
    // marker inert (SEC-036): a profile delete takes its own marker with
    // it. Names the site uses for itself are reserved. updatedAt is
    // server-pinned because the shared sitemap publishes it as <lastmod>
    // (SEC-035).
    match /profiles/{username} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && verifiedAccount()
                    && username.matches('[a-z0-9-]{3,30}')
                    && !(username in [
                         'admin', 'administrator', 'api', 'app', 'assets', 'auth', 'book',
                         'books', 'help', 'isbns', 'login', 'logout', 'null', 'owner',
                         'profile', 'profiles', 'register', 'root', 'sitemap', 'static',
                         'support', 'system', 'undefined', 'www'
                       ])
                    && validProfile()
                    && validProfileClaim(username);
      allow update: if request.auth != null
                    && verifiedAccount()
                    && resource.data.uid == request.auth.uid
                    && validProfile();
      // A tombstoned profile is the record of a deleted account; only an
      // operator purge removes it. accountLive() closes the window in
      // which deleteUserDocument has tombstoned users/{uid} but not yet
      // reached this profile: the residual identity (its ID token lives an
      // hour past deletion) must not delete its own not-yet-tombstoned
      // profile and free the reserved name. Not verifiedAccount(): an
      // unverified live owner may still delete what it has.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && resource.data.get('deletedAt', null) == null
                    && accountLive()
                    && validProfileRelease(username);
    }

    // The batch that creates profiles/{username} must leave
    // profileOwners/{uid} naming it, and if the account already held a
    // username that profile must be gone in the same batch (rename).
    // Ternaries, not ||: a get() inside a path is evaluated eagerly, and
    // a missing record must not be a null-value error.
    function validProfileClaim(username) {
      let owner = /databases/$(database)/documents/profileOwners/$(request.auth.uid);
      return existsAfter(owner)
             && getAfter(owner).data.username == username
             && (exists(owner)
                 ? !existsAfter(/databases/$(database)/documents/profiles/$(get(owner).data.username))
                 : true);
    }

    // Deleting a profile must release the ownership record (or move it to
    // the renamed profile) and take the profile's own discovery marker
    // with it; a marker left behind by another account is not ours to
    // touch and is inert without a uid-matching profile.
    function validProfileRelease(username) {
      let owner = /databases/$(database)/documents/profileOwners/$(request.auth.uid);
      let marker = /databases/$(database)/documents/profileDiscovery/$(username);
      return (existsAfter(owner) ? getAfter(owner).data.username != username : true)
             && (exists(marker)
                 ? (!existsAfter(marker) || get(marker).data.uid != request.auth.uid)
                 : true);
    }

    // Owner-only, and only ever moved inside a profile batch: it may name
    // a username only while that profile exists after the batch and is
    // ours, and it may stop naming one only once that profile is gone.
    match /profileOwners/{ownerUid} {
      allow read: if request.auth != null && ownerUid == request.auth.uid;
      allow create: if request.auth != null && ownerUid == request.auth.uid
                    && validProfileOwnerRecord()
                    && ownsProfileAfter(request.resource.data.username);
      allow update: if request.auth != null && ownerUid == request.auth.uid
                    && validProfileOwnerRecord()
                    && ownsProfileAfter(request.resource.data.username)
                    && (resource.data.username == request.resource.data.username
                        || !existsAfter(/databases/$(database)/documents/profiles/$(resource.data.username)));
      // A profile from before this record existed has none; the client's
      // delete batch removes the record unconditionally, and a delete of a
      // missing document must not be a null-value error (resource is null).
      allow delete: if request.auth != null && ownerUid == request.auth.uid
                    && (resource == null
                        ? true
                        : !existsAfter(/databases/$(database)/documents/profiles/$(resource.data.username)));
    }

    function validProfileOwnerRecord() {
      let record = request.resource.data;
      return record.keys().hasAll(['username'])
             && record.keys().hasOnly(['username'])
             && record.username is string
             && record.username.matches('[a-z0-9-]{3,30}');
    }

    function ownsProfileAfter(username) {
      let path = /databases/$(database)/documents/profiles/$(username);
      return existsAfter(path) && getAfter(path).data.uid == request.auth.uid;
    }

    function validProfile() {
      let profile = request.resource.data;
      let statKeys = ['totalBooks', 'finishedBooks', 'readingBooks', 'totalTimeReadHours',
                      'totalPagesRead', 'booksPerYear', 'avgTimePerBook', 'authors'];
      return profile.keys().hasAll(['uid', 'public', 'givenName', 'familyName', 'links', 'stats', 'records', 'years', 'days', 'updatedAt'])
             && profile.keys().hasOnly(['uid', 'public', 'givenName', 'familyName', 'links', 'stats', 'records', 'years', 'days', 'updatedAt'])
             && profile.uid == request.auth.uid
             && profile.public is bool
             && profile.givenName is string
             && profile.givenName.size() <= 50
             && profile.familyName is string
             && profile.familyName.size() <= 50
             // Public handles ({type, value, label?}); rules can't iterate
             // list elements, so the per-entry shape and string caps are
             // client-enforced (utils/links.ts). Owner-authenticated
             // writes only, and the client renders values as text and
             // scheme-guarded hrefs, so the count cap bounds the surface.
             && profile.links is list
             && profile.links.size() <= 10
             && profile.stats is map
             && profile.stats.keys().hasAll(statKeys)
             && profile.stats.keys().hasOnly(statKeys)
             && profile.stats.totalBooks is number
             && profile.stats.finishedBooks is number
             && profile.stats.readingBooks is number
             && profile.stats.totalTimeReadHours is number
             && profile.stats.totalPagesRead is number
             && profile.stats.booksPerYear is number
             && profile.stats.avgTimePerBook is number
             && profile.stats.authors is number
             && validProfileRecords(profile.records)
             // One row per year with finished books; 200 outlives everyone.
             && profile.years is list
             && profile.years.size() <= 200
             // Per-day heatmap aggregates: one entry per active reading
             // day, so 4000 is over a decade of daily reading. The client
             // clamps to the newest 4000 (PROFILE_MAX_DAYS) to match.
             && profile.days is list
             && profile.days.size() <= 4000
             && profile.updatedAt == request.time;
    }

    function validProfileRecords(records) {
      return records == null
             || (records is map
                 && records.keys().hasAll(['momentum', 'superlatives'])
                 && records.keys().hasOnly(['momentum', 'superlatives'])
                 && validProfileMomentum(records.momentum)
                 && validProfileSuperlatives(records.superlatives));
    }

    function validProfileMomentum(momentum) {
      return momentum == null
             || (momentum is map
                 && momentum.keys().hasAll(['recentPagesPerDay', 'lifetimePagesPerDay', 'ratio'])
                 && momentum.keys().hasOnly(['recentPagesPerDay', 'lifetimePagesPerDay', 'ratio'])
                 && momentum.recentPagesPerDay is number
                 && momentum.lifetimePagesPerDay is number
                 && (momentum.ratio == null || momentum.ratio is number));
    }

    function validProfileSuperlatives(records) {
      return records is map
             && records.keys().hasAll(['biggestDay', 'longestSession', 'medianSessionMinutes', 'fastestFinish'])
             && records.keys().hasOnly(['biggestDay', 'longestSession', 'medianSessionMinutes', 'fastestFinish'])
             && (records.biggestDay == null
                 || (records.biggestDay is map
                     && records.biggestDay.keys().hasAll(['day', 'pages'])
                     && records.biggestDay.keys().hasOnly(['day', 'pages'])
                     && records.biggestDay.day is string
                     && records.biggestDay.pages is number))
             && (records.longestSession == null
                 || (records.longestSession is map
                     && records.longestSession.keys().hasAll(['minutes'])
                     && records.longestSession.keys().hasOnly(['minutes'])
                     && records.longestSession.minutes is number))
             && records.medianSessionMinutes is number
             && (records.fastestFinish == null
                 || (records.fastestFinish is map
                     && records.fastestFinish.keys().hasAll(['days', 'pageCount'])
                     && records.fastestFinish.keys().hasOnly(['days', 'pageCount'])
                     && records.fastestFinish.days is number
                     && records.fastestFinish.pageCount is number));
    }

    // logEvents (the durable issue log the admin overview reads) and
    // adminAudit intentionally have no match blocks: both are written and
    // read exclusively by the Admin SDK. Clients used to create logEvents
    // rows directly — anonymously for failed sign-ins, and under their own
    // uid once signed in. The anonymous branch was an unauthenticated write
    // endpoint anyone could flood (billed writes, billed storage mirrored by
    // PITR and every backup, billed TTL deletes), and the authenticated one
    // had no rate limit, so one account could bury the operator's feed
    // (SEC-001, SEC-038). Signed-in clients now report through the
    // telemetry-reportissue callable, which allowlists the event, bounds
    // every field, pins the uid, refuses any free-form detail (SEC-029) and
    // counts reports per user in users/{uid}/functionQuotas/issueReports —
    // a document no client rule reaches. Anonymous sign-in failures are no
    // longer recorded at all: the only thing a signed-out client could
    // truthfully report was that its own attempt failed, and that signal
    // was not worth an open write path.

    match /{path=**}/updates/{updateId} {
      allow read: if request.auth != null &&
                     resource.data.owner == /databases/$(database)/documents/users/$(request.auth.uid);
    }
  }
}
