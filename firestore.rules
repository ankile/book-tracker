rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && userId == request.auth.uid;
    }
    match /users/{userId}/books/{bookId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow create: if request.auth != null && userId == request.auth.uid
                    && validBookTitle()
                    && validInitialBookTimer();
      allow update: if request.auth != null && userId == request.auth.uid
                    && validBookTitle()
                    && validBookTimerTransition();
      allow delete: if request.auth != null && userId == request.auth.uid
                    && resource.data.get('activeTimer', null) == null;

      // Writes are validated so a client cannot forge owner — which the
      // collectionGroup rule below trusts for cross-book stats reads — nor
      // point book at another document or invent an unknown type.
      match /updates/{updateId} {
        allow read, delete: if request.auth != null && userId == request.auth.uid;
        allow create, update: if request.auth != null && userId == request.auth.uid
                      && request.resource.data.owner == /databases/$(database)/documents/users/$(userId)
                      && request.resource.data.book == /databases/$(database)/documents/users/$(userId)/books/$(bookId)
                      && request.resource.data.type in ['reading', 'update'];
      }
    }

    // The callable owns Toggl lifecycle maps. Clients may start/stop a
    // local timer, clear a confirmed unknown outcome, or clear an ordinary
    // remote timer while queuing its offline stop. They cannot forge or
    // erase a start claim while the server may be issuing the remote POST.
    function validInitialBookTimer() {
      let timer = request.resource.data.get('activeTimer', null);
      return timer == null || validLocalTimer(timer);
    }

    function validBookTitle() {
      return request.resource.data.title is string
             && request.resource.data.title.size() > 0
             && request.resource.data.title.size() <= 500;
    }

    function validBookTimerTransition() {
      let before = resource.data.get('activeTimer', null);
      let after = request.resource.data.get('activeTimer', null);
      return before == after
             || (before == null && validLocalTimer(after))
             || (after == null
                 && (validLocalTimer(before)
                     || validRemoteTimer(before)
                     || validUnknownTimer(before)));
    }

    function validLocalTimer(timer) {
      return timer is map
             && timer.keys().hasAll(['start'])
             && timer.keys().hasOnly(['start'])
             && timer.start is string;
    }

    function validRemoteTimer(timer) {
      return timer is map
             && timer.keys().hasAll(['entryId', 'start'])
             && timer.keys().hasOnly(['entryId', 'start'])
             && timer.entryId is int
             && timer.entryId > 0
             && timer.start is string;
    }

    function validUnknownTimer(timer) {
      return timer is map
             && timer.keys().hasAll([
                  'state', 'operationId', 'start', 'claimedAt', 'error'
                ])
             && timer.keys().hasOnly([
                  'state', 'operationId', 'start', 'claimedAt', 'error'
                ])
             && timer.state == 'outcome-unknown'
             && timer.operationId is string
             && timer.start is string
             && timer.claimedAt is timestamp
             && timer.error is string;
    }
    // Author entities, written in the same client batch as the book that
    // references them. Own-user private data, so books-level strictness
    // applies (the validation-heavy style is for anonymous surfaces).
    match /users/{userId}/authors/{authorId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow create: if request.auth != null && userId == request.auth.uid
                    && !request.resource.data.keys().hasAny(['retirement']);
      allow update: if request.auth != null && userId == request.auth.uid
                    && validAuthorRetirementTransition(userId, authorId);
    }

    function validAuthorRetirementTransition(userId, authorId) {
      let before = resource.data.get('retirement', null);
      let after = request.resource.data.get('retirement', null);
      return before == after
             || (before is map
                 && before.reason == 'deleted'
                 && after == null)
             || (before == null
                 && after is map
                 && ((after.keys().hasAll(['reason'])
                      && after.keys().hasOnly(['reason'])
                      && after.reason == 'deleted')
                     || (after.keys().hasAll(['reason', 'targetId'])
                         && after.keys().hasOnly(['reason', 'targetId'])
                         && after.reason == 'merged'
                         && after.targetId is string
                         && after.targetId != authorId
                         && get(/databases/$(database)/documents/users/$(userId)/authors/$(after.targetId)).data.get('retirement', null) == null)));
    }

    // Offline Toggl sync queue: an owner can enqueue one exact, bounded
    // payload and read its lifecycle. The Admin SDK alone writes processing,
    // error and synced states. A client retry can only set pending plus a new
    // server timestamp, only after the same stale windows the client sweep
    // uses, and never after the fifth claim. The timestamp makes a retry of
    // an unchanged pending status emit a production Firestore event. The
    // server-owned per-user quota bounds all claim attempts to ten per hour;
    // terminal rows expire through the server-owned TTL field.
    match /users/{userId}/togglQueue/{queueId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow create: if request.auth != null && userId == request.auth.uid
                    && togglConfigured(userId)
                    && validInitialTogglQueueItem()
                    && (togglQueueQuotaAvailable(userId)
                        || validAtomicTimerStop(userId, queueId));
      allow update: if request.auth != null && userId == request.auth.uid
                    && togglConfigured(userId)
                    && togglQueueQuotaAvailable(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'retryRequestedAt'])
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasAll(['retryRequestedAt'])
                    && request.resource.data.status == 'pending'
                    && validRetryTogglQueueItem()
                    && resource.data.get('attempts', 0) < 5
                    && togglRetryWindowOpen();
    }

    function validInitialTogglQueueItem() {
      let item = request.resource.data;
      return validTogglQueuePayload(item)
             && item.status == 'pending'
             && item.createdAt is timestamp
             && item.keys().hasOnly([
                  'type', 'bookId', 'bookTitle', 'start', 'stop', 'entryId',
                  'status', 'createdAt'
                ]);
    }

    function validRetryTogglQueueItem() {
      let item = request.resource.data;
      return validTogglQueuePayload(item)
             && item.status == 'pending'
             && item.createdAt is timestamp
             && item.retryRequestedAt is timestamp
             && item.retryRequestedAt == request.time
             && item.keys().hasOnly([
                  'type', 'bookId', 'bookTitle', 'start', 'stop', 'entryId',
                  'status', 'createdAt', 'attempts', 'claimedAt', 'error',
                  'expiresAt', 'retryRequestedAt'
                ])
             && ((!item.keys().hasAny(['attempts', 'claimedAt', 'error']))
                  || (item.attempts is int
                      && item.attempts > 0
                      && item.attempts < 5
                      && item.claimedAt is timestamp
                      && (!item.keys().hasAny(['error'])
                          || (item.error is string
                              && (item.error.size() <= 1000
                                  || item.error == resource.data.error)))));
    }

    function validTogglQueuePayload(item) {
      return item.keys().hasAll([
               'type', 'bookTitle', 'start', 'stop', 'status', 'createdAt'
             ])
             && item.type in ['create', 'stop']
             && (!item.keys().hasAny(['bookId'])
                  || (item.bookId is string
                      && item.bookId.matches('[^/]{1,500}')
                      && item.bookId != '.'
                      && item.bookId != '..'))
             && item.bookTitle is string
             && item.bookTitle.size() > 0
             && item.bookTitle.size() <= 500
             && item.start is string
             && item.start.size() > 0
             && item.start.size() <= 64
             && item.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})')
             && item.stop is string
             && item.stop.size() > 0
             && item.stop.size() <= 64
             && item.stop.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})')
             && (item.type == 'create'
                  ? !item.keys().hasAny(['entryId'])
                  : (item.keys().hasAll(['entryId'])
                     && item.entryId is int
                     && item.entryId > 0));
    }

    // A full claim quota must not make an offline stop roll its book timer
    // back. The narrow exception below only accepts the deterministic queue
    // row written in the same batch that clears that exact timer. Ordinary
    // creates, including legacy clients without bookId, remain quota-gated.
    function validAtomicTimerStop(userId, queueId) {
      let item = request.resource.data;
      let bookId = item.get('bookId', '');
      let path = /databases/$(database)/documents/users/$(userId)/books/$(bookId);
      let before = get(path).data;
      let timer = before.get('activeTimer', null);
      return item.keys().hasAll(['bookId'])
             && queueId == bookId + '_' + item.start
             && exists(path)
             && getAfter(path).data.get('activeTimer', null) == null
             && ((item.type == 'create'
                  && validLocalTimer(timer)
                  && timer.start == item.start)
                 || (item.type == 'stop'
                     && validRemoteTimer(timer)
                     && timer.entryId == item.entryId
                     && timer.start == item.start));
    }

    function togglRetryWindowOpen() {
      return resource.data.status == 'error'
             || (resource.data.status == 'pending'
                 && resource.data.createdAt is timestamp
                 && resource.data.createdAt
                    < request.time - duration.value(600, 's'))
             || (resource.data.status == 'processing'
                 && resource.data.claimedAt is timestamp
                 && resource.data.claimedAt
                    < request.time - duration.value(21600, 's'));
    }

    function togglConfigured(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      let toggl = get(path).data.get('toggl', null);
      return exists(path)
             && toggl is map
             && toggl.keys().hasAll(['apiToken', 'workspaceId', 'projectId'])
             && toggl.keys().hasOnly(['apiToken', 'workspaceId', 'projectId'])
             && toggl.apiToken is string
             && toggl.apiToken.size() > 0
             && toggl.workspaceId is int
             && toggl.workspaceId > 0
             && toggl.projectId is int
             && toggl.projectId > 0;
    }

    function togglQueueQuotaAvailable(userId) {
      let path = /databases/$(database)/documents/users/$(userId)/functionQuotas/togglQueue;
      return !exists(path)
             || (get(path).data.keys().hasAll(['windowStartedAt', 'count'])
                 && get(path).data.keys().hasOnly(['windowStartedAt', 'count'])
                 && get(path).data.windowStartedAt is timestamp
                 && get(path).data.count is int
                 && get(path).data.count >= 0
                 && (get(path).data.windowStartedAt
                       <= request.time - duration.value(3600, 's')
                     || get(path).data.count < 10));
    }

    // Opt-in public profile pages: /profiles/<username> renders this doc.
    // `get` is open only while the owner has explicitly flipped the doc's
    // `public` flag; otherwise only the signed-in owner can read it — a
    // private profile reads as permission-denied to everyone else, which
    // the client renders as not-found so username existence never leaks.
    // (A get on a missing doc also lands here as an evaluation error →
    // denied, deliberately the same signal.) `list` is owner-only — the Me
    // page finds its own doc by querying on uid, and strangers must not be
    // able to enumerate usernames. The username is the doc id, so
    // uniqueness is first-writer-wins: a create against an existing doc
    // evaluates as an update and fails the uid pin. Anonymous-readable
    // surface, so the validation-heavy style applies: the shape is pinned
    // so the doc can only ever hold aggregate reading numbers plus two
    // deliberately short name parts (givenName/familyName, the app-wide
    // person-name convention) — nothing a profile link could be used to
    // host arbitrary content on.
    match /profiles/{username} {
      allow get: if resource.data.public == true
                 || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && username.matches('[a-z0-9-]{3,30}')
                    && validProfile();
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && validProfile();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    function validProfile() {
      let profile = request.resource.data;
      let statKeys = ['totalBooks', 'finishedBooks', 'readingBooks', 'totalTimeReadHours',
                      'totalPagesRead', 'booksPerYear', 'avgTimePerBook', 'authors'];
      return profile.keys().hasAll(['uid', 'public', 'givenName', 'familyName', 'links', 'stats', 'records', 'years', 'days', 'updatedAt'])
             && profile.keys().hasOnly(['uid', 'public', 'givenName', 'familyName', 'links', 'stats', 'records', 'years', 'days', 'updatedAt'])
             && profile.uid == request.auth.uid
             && profile.public is bool
             && profile.givenName is string
             && profile.givenName.size() <= 50
             && profile.familyName is string
             && profile.familyName.size() <= 50
             // Public handles ({type, value, label?}); rules can't iterate
             // list elements, so the per-entry shape and string caps are
             // client-enforced (utils/links.ts). Owner-authenticated
             // writes only, and the client renders values as text and
             // scheme-guarded hrefs, so the count cap bounds the surface.
             && profile.links is list
             && profile.links.size() <= 10
             && profile.stats is map
             && profile.stats.keys().hasAll(statKeys)
             && profile.stats.keys().hasOnly(statKeys)
             && profile.stats.totalBooks is number
             && profile.stats.finishedBooks is number
             && profile.stats.readingBooks is number
             && profile.stats.totalTimeReadHours is number
             && profile.stats.totalPagesRead is number
             && profile.stats.booksPerYear is number
             && profile.stats.avgTimePerBook is number
             && profile.stats.authors is number
             && validProfileRecords(profile.records)
             // One row per year with finished books; 200 outlives everyone.
             && profile.years is list
             && profile.years.size() <= 200
             // Per-day heatmap aggregates: one entry per active reading
             // day, so 4000 is over a decade of daily reading. The client
             // clamps to the newest 4000 (PROFILE_MAX_DAYS) to match.
             && profile.days is list
             && profile.days.size() <= 4000
             && profile.updatedAt is timestamp;
    }

    function validProfileRecords(records) {
      return records == null
             || (records is map
                 && records.keys().hasAll(['momentum', 'superlatives'])
                 && records.keys().hasOnly(['momentum', 'superlatives'])
                 && validProfileMomentum(records.momentum)
                 && validProfileSuperlatives(records.superlatives));
    }

    function validProfileMomentum(momentum) {
      return momentum == null
             || (momentum is map
                 && momentum.keys().hasAll(['recentPagesPerDay', 'lifetimePagesPerDay', 'ratio'])
                 && momentum.keys().hasOnly(['recentPagesPerDay', 'lifetimePagesPerDay', 'ratio'])
                 && momentum.recentPagesPerDay is number
                 && momentum.lifetimePagesPerDay is number
                 && (momentum.ratio == null || momentum.ratio is number));
    }

    function validProfileSuperlatives(records) {
      return records is map
             && records.keys().hasAll(['biggestDay', 'longestSession', 'medianSessionMinutes', 'fastestFinish'])
             && records.keys().hasOnly(['biggestDay', 'longestSession', 'medianSessionMinutes', 'fastestFinish'])
             && (records.biggestDay == null
                 || (records.biggestDay is map
                     && records.biggestDay.keys().hasAll(['day', 'pages'])
                     && records.biggestDay.keys().hasOnly(['day', 'pages'])
                     && records.biggestDay.day is string
                     && records.biggestDay.pages is number))
             && (records.longestSession == null
                 || (records.longestSession is map
                     && records.longestSession.keys().hasAll(['minutes'])
                     && records.longestSession.keys().hasOnly(['minutes'])
                     && records.longestSession.minutes is number))
             && records.medianSessionMinutes is number
             && (records.fastestFinish == null
                 || (records.fastestFinish is map
                     && records.fastestFinish.keys().hasAll(['days', 'pageCount'])
                     && records.fastestFinish.keys().hasOnly(['days', 'pageCount'])
                     && records.fastestFinish.days is number
                     && records.fastestFinish.pageCount is number));
    }

    // Durable issue log read by the admin overview (Admin SDK only — no
    // client read, so one user's failures are never visible to another).
    // Create-only so telemetry cannot be scrubbed, and uid is pinned to the
    // session so rows cannot be attributed to someone else. Anonymous
    // creates are allowed with uid == null so failed sign-ins before any
    // session exists still land (detail.email carries the attempted
    // address) — that path is unauthenticated and therefore spammable, so
    // everything it can influence is constrained:
    //
    //   - createdAt == request.time. The admin panel orders by this field
    //     and shows a fixed number of rows, so a client-chosen timestamp
    //     was a blinding attack: rows dated year 9999 pin every slot
    //     permanently (no client delete exists), and back-dated rows fall
    //     out of the query window unseen.
    //   - expiresAt is bounded, so the TTL policy on it caps retention and
    //     the collection cannot grow without limit. The window is wide
    //     because a device with a skewed clock must still be able to log.
    //   - event is an allowlist, and the anonymous set is narrower than
    //     the authenticated one, so forged rows cannot impersonate app
    //     subsystems the caller could not actually have reached.
    //
    // adminAudit intentionally has no match block: it is written and read
    // exclusively by the Admin SDK.
    match /logEvents/{eventId} {
      allow create: if validIssue()
                    && (request.auth == null
                          ? (request.resource.data.uid == null
                             && request.resource.data.event in ['auth.sign_in_failed', 'auth.sign_up_failed'])
                          : (request.resource.data.uid == request.auth.uid
                             && request.resource.data.event in ['firestore.listener_failed',
                                                                'firestore.decode_failed',
                                                                'firestore.write_failed',
                                                                'toggl.sync_stuck']));
    }

    function validIssue() {
      let issue = request.resource.data;
      return issue.keys().hasAll(['level', 'event', 'message', 'code', 'uid', 'detail', 'createdAt', 'expiresAt'])
             && issue.keys().hasOnly(['level', 'event', 'message', 'code', 'uid', 'detail', 'createdAt', 'expiresAt'])
             && issue.level in ['warn', 'error']
             && issue.event is string
             && issue.message is string
             && issue.message.size() <= 1000
             && (issue.code == null || (issue.code is string && issue.code.size() <= 100))
             && (issue.detail == null
                 || (issue.detail is map
                     && issue.detail.keys().hasOnly(['email'])
                     && (!issue.detail.keys().hasAny(['email'])
                         || (issue.detail.email is string && issue.detail.email.size() <= 320))))
             && issue.createdAt == request.time
             && issue.expiresAt is timestamp
             && issue.expiresAt > request.time
             && issue.expiresAt < request.time + duration.value(120, 'd');
    }

    match /{path=**}/updates/{updateId} {
      allow read: if request.auth != null &&
                     resource.data.owner == /databases/$(database)/documents/users/$(request.auth.uid);
    }
  }
}
